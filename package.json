{
  "name": "dsh-qqnt-chat-export",
  "version": "0.13.1",
  "description": "Read, search, and export NTQQ chat history (groups and private chats) as text, CSV, JSON, Markdown, HTML, or SQLite on Windows and Linux — a DeepSeek Harness bundle with model tools and a local web UI at http://127.0.0.1:46728/ (port configurable).",
  "type": "module",
  "license": "MIT",
  "author": "ariyflow <ariyflow@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariyflow/dsh-qqnt-chat-export.git"
  },
  "bugs": {
    "url": "https://github.com/ariyflow/dsh-qqnt-chat-export/issues"
  },
  "homepage": "https://github.com/ariyflow/dsh-qqnt-chat-export#readme",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "qq",
    "ntqq",
    "chat-export",
    "sqlcipher"
  ],
  "os": [
    "win32",
    "linux"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "web.js",
    "settings.js",
    "storage.js",
    "exportQueue.js",
    "presets.js",
    "page.html",
    "screenshots.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.py",
    "docs/screenshot.png",
    "docs/screenshot-stats.png",
    "docs/wal-notes.md",
    "docs/media-notes.md",
    "docs/windows-checklist.md",
    "docs/verification-windows.md",
    "CHANGELOG.md",
    "python"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
