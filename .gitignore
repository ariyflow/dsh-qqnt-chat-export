# Local data the plugin produces or reads — never commit any of it.
node_modules/
__pycache__/
*.pyc

# Decrypted databases, keys, and the query index live in the work directory,
# which defaults to the system temp dir (%TEMP%\qqnt-chat-export on Windows,
# /tmp/qqnt-chat-export on Linux). Keep an accidental copy out of git.
key.txt
nt_msg.db*
index.sqlite*
build-status.json
.qqnt-work/
exports/
QQ导出_*/

